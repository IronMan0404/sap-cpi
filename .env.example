# Path to the local SAP BTP service-key JSON file. Leave this set when using
# the JSON key; the explicit CPI_* values below take precedence when present.
CPI_SERVICE_KEY_FILE=./DEMO-API-KEY.json

# Optional overrides. These can also be populated from DEMO-API-KEY.json.
# CPI_CLIENT_ID=
# CPI_CLIENT_SECRET=
# CPI_TOKEN_URL=
# CPI_API_URL=
# CPI_API_PATH=/api/v1

# Optional request timeout in seconds.
CPI_TIMEOUT=30
